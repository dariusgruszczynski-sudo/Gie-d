# --- Claude (decyzje inwestycyjne) ---
ANTHROPIC_API_KEY=
# Każdy cykl analizuje najpierw model szybki/tani (Sonnet). Jego decyzja jest
# wykonywana wprost przy HOLD albo pewnym BUY/SELL; niepewny BUY/SELL (poniżej
# progu ufności) jest eskalowany do modelu wolniejszego/droższego (Opus) po
# ostateczną decyzję.
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MODEL_FAST=claude-sonnet-5
CLAUDE_ESCALATION_CONFIDENCE_THRESHOLD=0.65

# --- Alpaca ---
# Wygeneruj klucz na app.alpaca.markets/paper/dashboard/overview (paper) albo
# app.alpaca.markets/live/dashboard/overview (live) -- w przeciwieństwie do
# Kraken, Alpaca ma prawdziwe środowisko paper-trading z identycznym API, więc
# ALPACA_PAPER=true pozwala przetestować bota bezpiecznie na symulowanym
# koncie przed przełączeniem na żywe pieniądze.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# true = konto paper (symulacja), false = żywe pieniądze
ALPACA_PAPER=false
QUOTE_CURRENCY=USD

# --- Zarządzanie ryzykiem ---
DAILY_LOSS_LIMIT_PCT=20
WEEKLY_LOSS_LIMIT_PCT=70
MAX_POSITION_PCT=25
# Automatyczne wyjścia z pozycji (bez pytania Claude). STOP_LOSS_PCT to twarda
# podłoga od ceny wejścia. Po stracie ta sama para jest blokowana do odkupu na
# STOP_LOSS_COOLDOWN_MINUTES (ochrona przed piłowaniem konta prowizjami).
STOP_LOSS_PCT=2
STOP_LOSS_COOLDOWN_MINUTES=60
# Realizacja zysku: przy TRAILING_STOP_ENABLED=true (domyślnie) po zysku
# +TAKE_PROFIT_PCT uzbraja się trailing-stop -- pozycja jest sprzedawana dopiero
# gdy cena spadnie TRAILING_STOP_PCT od szczytu (zyski mogą rosnąć). Przy
# TRAILING_STOP_ENABLED=false: sztywny take-profit -- sprzedaż od razu przy
# +TAKE_PROFIT_PCT.
TAKE_PROFIT_PCT=3
TRAILING_STOP_ENABLED=true
TRAILING_STOP_PCT=1.5
# Mail natychmiast po każdej transakcji (używa tej samej konfiguracji SMTP co
# raport dzienny; pomijany gdy SMTP nieustawiony). false = tylko raport dzienny.
TRADE_ALERTS_ENABLED=true
# Szeroki ETF rynkowy + płynne, dużej kapitalizacji akcje z dostępnymi
# zleceniami ułamkowymi/kwotowymi (notional) na Alpaca -- ważne przy małym
# koncie, bo cena akcji nie musi dzielić się równo na wielkość pozycji.
# Zlecenia bez prowizji, ale rynek działa tylko w godzinach sesji US.
# ZRÓŻNICOWANA lista (nie tylko tech beta): rdzeń SPY/QQQ/AAPL/NVDA, zmienny
# MSTR, aktywa nieskorelowane/defensywne GLD (złoto)/TLT (obligacje)/XLE
# (energia)/IWM (small-capy) oraz ETF-y ODWROTNE SH (inverse S&P)/PSQ (inverse
# Nasdaq) -- pozwalają zarabiać też na spadkach kupując je jak zwykłą pozycję,
# bez ryzyka klasycznego shorta.
TRADING_WHITELIST=SPY,QQQ,AAPL,NVDA,MSTR,GLD,TLT,XLE,IWM,SH,PSQ
# Benchmark: z czym porównywać całą strategię (bierne trzymanie tego tickera).
# Jeśli bot nie bije trzymania SPY, nie zarabia na swojej złożoności.
BENCHMARK_SYMBOL=SPY
# Sizing wg zmienności: rozmiar BUY jest skalowany W DÓŁ dla tickerów bardziej
# zmiennych niż ten próg (odchylenie std zwrotów 1h w %). 0 = wyłącz.
VOLATILITY_REFERENCE_PCT=1.0
# Dolny limit skalowania -- zmienny ticker nie zejdzie poniżej tej części tego,
# o co prosił Claude (żeby nie zsuwać pozycji do zera).
VOLATILITY_MIN_SCALE=0.35

# --- Harmonogram ---
POLL_INTERVAL_MINUTES=15
# Próg ruchu ceny liczony NARASTAJĄCO od ostatniej analizy (kotwica), nie od
# poprzedniego sprawdzenia -- powolny trend też w końcu wyzwala analizę.
PRICE_MOVE_TRIGGER_PCT=2
# Heartbeat: pełna analiza Claude co najmniej co tyle minut w godzinach
# handlu, nawet bez ruchu ceny -- bot regularnie patrzy na rynek zamiast
# czekać wyłącznie na skoki. 0 = wyłącz.
FULL_ANALYSIS_EVERY_MINUTES=120
# Sesja regularna to tylko ~6.5h/dzień (9:30-16:00 czasu New York).
# Rozszerzone godziny dokładają pre-market (4:00-9:30) i after-hours
# (16:00-20:00) na TYM SAMYM koncie Alpaca -- ~16h/dzień pokrycia. Zlecenia
# tam to zawsze CAŁE akcje (limit order), nie ułamkowe/kwotowe -- przy małym
# koncie kawałek pozycji jest mniejszy niż 1 akcja, więc rozszerzone godziny
# nic tam nie kupią/nie sprzedadzą. Dlatego domyślnie manualny przełącznik
# jest OFF, a otwiera się automatycznie dopiero po przekroczeniu progu niżej.
EXTENDED_HOURS_TRADING_ENABLED=false
# Automatyczne włączenie rozszerzonych godzin, gdy wartość portfela osiągnie
# tyle USD (bez ruszania przełącznika wyżej). 0 = wyłącz auto.
EXTENDED_HOURS_AUTO_ENABLE_USD=500
# Wyższy próg niż PRICE_MOVE_TRIGGER_PCT stosowany TYLKO w pre-market/
# after-hours -- rutynowy dryf poza sesją regularną znaczy mniej, a bez tego
# ~2.5x dłuższe okno handlu ~2.5x zwiększyłoby zużycie budżetu Claude przy
# tej samej jakości sygnału.
EXTENDED_HOURS_PRICE_MOVE_TRIGGER_PCT=4
# Blokada wejścia przed wynikami: mechaniczny stop-loss NIE chroni przed luką
# po earnings (cena przeskakuje stopa). Automat nie otworzy nowej pozycji na
# tickerze raportującym w ciągu tylu dni (SELL/HOLD nadal dozwolone). 0 =
# wyłącz. Działa tylko na ZNANE daty -- awaria kalendarza nie blokuje handlu.
EARNINGS_BLACKOUT_DAYS=2

# --- Budżet Claude (szacunek, nie realne saldo z console.anthropic.com - patrz README) ---
# Ustaw na kwotę, którą realnie doładowałeś na koncie Anthropic
CLAUDE_MONTHLY_BUDGET_USD=20
# Alert na dashboardzie gdy szacowane zużycie przekroczy ten % budżetu
CLAUDE_BUDGET_ALERT_THRESHOLD_PCT=80

# --- Codzienny raport mailowy (SMTP, np. Gmail + hasło aplikacji) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
REPORT_RECIPIENT_EMAIL=0grucha0@gmail.com
REPORT_HOUR=6
REPORT_MINUTE=0
REPORT_TIMEZONE=Europe/Warsaw

# --- Baza danych ---
DATABASE_URL=sqlite:///./data/trading.db

# --- Logowanie do dashboardu (opcjonalnie, jeśli puste - brak logowania!) ---
# Format: uzytkownik1:haslo1,uzytkownik2:haslo2
DASHBOARD_USERS=
