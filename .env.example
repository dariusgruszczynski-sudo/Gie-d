# --- Claude (decyzje inwestycyjne) ---
ANTHROPIC_API_KEY=
# Każdy cykl analizuje najpierw model szybki/tani (Sonnet). Jego decyzja jest
# wykonywana wprost przy HOLD albo pewnym BUY/SELL; niepewny BUY/SELL (poniżej
# progu ufności) jest eskalowany do modelu wolniejszego/droższego (Opus) po
# ostateczną decyzję.
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MODEL_FAST=claude-sonnet-5
CLAUDE_ESCALATION_CONFIDENCE_THRESHOLD=0.65

# --- Kraken ---
# Wygeneruj klucz na kraken.com/u/security/api z uprawnieniami TYLKO
# "Query Funds" + "Create & Modify Orders" -- NIGDY nie włączaj uprawnień do
# wypłat (withdraw). Kraken nie ma publicznego testnetu dla rynku spot --
# w odróżnieniu od Binance każde wywołanie prywatnego API jest realne.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
QUOTE_CURRENCY=EUR

# --- Newsy (opcjonalnie, jeśli puste - system pomija CryptoPanic; reszta
# źródeł -- RSS, Reddit, CoinGecko, Fear&Greed, DeFiLlama -- działa zawsze,
# bez klucza) ---
CRYPTOPANIC_API_KEY=

# --- Zarządzanie ryzykiem ---
DAILY_LOSS_LIMIT_PCT=20
WEEKLY_LOSS_LIMIT_PCT=70
MAX_POSITION_PCT=25
# Automatyczne wyjścia z pozycji (bez pytania Claude): sprzedaj całość gdy
# pozycja zyska >= TAKE_PROFIT_PCT albo straci >= STOP_LOSS_PCT względem
# średniej ceny wejścia. To dzięki temu bot "obraca kapitałem". 0 = wyłącz.
TAKE_PROFIT_PCT=3
STOP_LOSS_PCT=2
# Pary Kraken (BTC nazywa się tam "XBT") w EUR -- 4 najpłynniejsze rynki wg
# kapitalizacji.
TRADING_WHITELIST=XBTEUR,ETHEUR,SOLEUR,XRPEUR

# --- Harmonogram ---
POLL_INTERVAL_MINUTES=15
PRICE_MOVE_TRIGGER_PCT=2

# --- Budżet Claude (szacunek, nie realne saldo z console.anthropic.com - patrz README) ---
# Ustaw na kwotę, którą realnie doładowałeś na koncie Anthropic
CLAUDE_MONTHLY_BUDGET_USD=20
# Alert na dashboardzie gdy szacowane zużycie przekroczy ten % budżetu
CLAUDE_BUDGET_ALERT_THRESHOLD_PCT=80

# --- Codzienny raport mailowy (SMTP, np. Gmail + hasło aplikacji) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
REPORT_RECIPIENT_EMAIL=0grucha0@gmail.com
REPORT_HOUR=6
REPORT_MINUTE=0
REPORT_TIMEZONE=Europe/Warsaw

# --- Baza danych ---
DATABASE_URL=sqlite:///./data/trading.db

# --- Logowanie do dashboardu (opcjonalnie, jeśli puste - brak logowania!) ---
# Format: uzytkownik1:haslo1,uzytkownik2:haslo2
DASHBOARD_USERS=
