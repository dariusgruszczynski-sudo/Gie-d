# --- Claude (decyzje inwestycyjne) ---
ANTHROPIC_API_KEY=
# Każdy cykl analizuje najpierw model szybki/tani (Sonnet). Jego decyzja jest
# wykonywana wprost przy HOLD albo pewnym BUY/SELL; niepewny BUY/SELL (poniżej
# progu ufności) jest eskalowany do modelu wolniejszego/droższego (Opus) po
# ostateczną decyzję.
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MODEL_FAST=claude-sonnet-5
CLAUDE_ESCALATION_CONFIDENCE_THRESHOLD=0.65
# LEAN-AI (małe konto): domyślnie NIE eskalujemy do droższego modelu (Opus) --
# jedno tanie wywołanie modelu szybkiego na cykl. Włącz (=true), gdy konto jest
# na tyle duże, że koszt Opusa to <2-3%/mies.
CLAUDE_ESCALATION_ENABLED=false
# Twardy bezpiecznik: gdy szacowany wydatek Claude przekroczy budżet miesięczny,
# automat wstrzymuje nowe wywołania (ręczne transakcje i wyjścia działają dalej).
CLAUDE_PAUSE_TRADING_AT_BUDGET=true

# --- Alpaca ---
# Wygeneruj klucz na app.alpaca.markets/paper/dashboard/overview (paper) albo
# app.alpaca.markets/live/dashboard/overview (live) -- w przeciwieństwie do
# Kraken, Alpaca ma prawdziwe środowisko paper-trading z identycznym API, więc
# ALPACA_PAPER=true pozwala przetestować bota bezpiecznie na symulowanym
# koncie przed przełączeniem na żywe pieniądze.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# true = konto paper (symulacja), false = żywe pieniądze
ALPACA_PAPER=false
QUOTE_CURRENCY=USD

# --- Krypto (drugi lot, 24/7, to samo konto Alpaca) ---
# Ten sam ALPACA_API_KEY/ALPACA_API_SECRET jak akcje -- nie trzeba osobnych
# kluczy. CRYPTO_ENABLED=false => drugi lot całkiem wyłączony (nic nie handluje).
CRYPTO_ENABLED=true
# Minimalna kwota (USD) zlecenia krypto -- guard po naszej stronie, żeby
# niedofinansowane konto nie strzelało wciąż odrzucanym zleceniem poniżej
# minimum giełdy. 0 = wyłącz.
CRYPTO_MIN_ORDER_USD=1
# Krypto spot, 24/7 (także weekend) -- pokrywa noce gdy rynek US zamknięty.
# Lista zweryfikowana jako aktualnie wspierana przez Alpaca (2026-07).
CRYPTO_WHITELIST=BTCUSD,ETHUSD,SOLUSD,LTCUSD,BCHUSD,DOGEUSD,LINKUSD,AVAXUSD,ADAUSD,DOTUSD,UNIUSD,AAVEUSD,XRPUSD,SHIBUSD

# --- DWA MÓZGI: agresywny profil KRYPTO (nadpisuje bazowe knoby akcji US) ---
# Bazowe knoby niżej to profil AKCJI US ("średnio agresywnie"). Krypto dostaje
# WŁASNY, agresywniejszy profil dla rynku 24/7. Zmień tu, żeby wykręcić agresję
# krypto bez ruszania akcji. (Puste = użyj wartości domyślnych z kodu.)
CRYPTO_RISK_PER_TRADE_PCT=2.0
CRYPTO_MAX_CONCURRENT_POSITIONS=6
CRYPTO_MIN_BUY_CONFIDENCE=0.52
CRYPTO_MAX_NEW_POSITIONS_PER_DAY=8
CRYPTO_MIN_HOLD_MINUTES=15
CRYPTO_MAX_POSITION_PCT=30
CRYPTO_REWARD_RISK_RATIO=2.5
CRYPTO_PARTIAL_TAKE_PROFIT_FRAC=0.40
CRYPTO_PARTIAL_TAKE_PROFIT_R=1.0
CRYPTO_STOP_LOSS_MIN_PCT=3.5
CRYPTO_STOP_LOSS_MAX_PCT=18
CRYPTO_VOLATILITY_REFERENCE_PCT=5.0
CRYPTO_PRICE_MOVE_TRIGGER_PCT=3.5
CRYPTO_FULL_ANALYSIS_EVERY_MINUTES=90

# --- Zarządzanie ryzykiem ---
# Podział kapitału między dwa silniki (JEDNO konto Alpaca, wspólna gotówka).
# Każdy silnik może zaangażować najwyżej swój % wartości konta -- 50/50 = równo,
# żeby agresywne krypto 24/7 nie zjadło gotówki dla US.
ALPACA_ALLOCATION_PCT=50
CRYPTO_ALLOCATION_PCT=50

DAILY_LOSS_LIMIT_PCT=20
# Zacieśnione z 70% -> 25%: realny bezpiecznik dla małego konta.
WEEKLY_LOSS_LIMIT_PCT=25
MAX_POSITION_PCT=25
# Automatyczne wyjścia z pozycji (bez pytania Claude). STOP_LOSS_PCT to twarda
# podłoga od ceny wejścia. Po stracie ta sama para jest blokowana do odkupu na
# STOP_LOSS_COOLDOWN_MINUTES (ochrona przed piłowaniem konta prowizjami).
STOP_LOSS_PCT=2
# Stop-loss oparty na zmienności (ATR): zamiast sztywnego %, dystans stopa =
# STOP_LOSS_VOL_MULT × zmienność 1h tickera, ograniczony do [MIN, MAX]. Dzięki
# temu spokojny indeks nie jest wytrząsany na 2% szumu (i sprzedawany w dołku),
# a zmienny ticker dostaje szerszy stop. STOP_LOSS_VOL_MULT=0 = wyłącz (wraca
# sztywny STOP_LOSS_PCT).
STOP_LOSS_VOL_MULT=6
STOP_LOSS_MIN_PCT=2.5
STOP_LOSS_MAX_PCT=12
STOP_LOSS_COOLDOWN_MINUTES=60
# Realizacja zysku: przy TRAILING_STOP_ENABLED=true (domyślnie) po zysku
# +TAKE_PROFIT_PCT uzbraja się trailing-stop -- pozycja jest sprzedawana dopiero
# gdy cena spadnie TRAILING_STOP_PCT od szczytu (zyski mogą rosnąć). Przy
# TRAILING_STOP_ENABLED=false: sztywny take-profit -- sprzedaż od razu przy
# +TAKE_PROFIT_PCT.
TAKE_PROFIT_PCT=3
TRAILING_STOP_ENABLED=true
TRAILING_STOP_PCT=1.5
# Geometria zysk/ryzyko (Pakiet 1): po zmianie stopa na ATR strona zysku była
# sztywna (+3% arm, 1.5% trailing), a stopy urosły do 2.5-12% -> ODWRÓCONY
# stosunek zysk/ryzyko (tniesz zwycięzców, trzymasz przegranych; diagnostyka:
# 0 wygranych, wszystkie wyjścia to stopy). Teraz nagroda jest SPRZĘŻONA z
# dystansem stopa: arm take-profit = stop × REWARD_RISK_RATIO, trailing = stop ×
# TRAILING_STOP_FRAC. REWARD_RISK_RATIO=0 => wróć do sztywnego TAKE_PROFIT_PCT.
REWARD_RISK_RATIO=1.5
TRAILING_STOP_FRAC=0.5
# Częściowa realizacja zysku: po osiągnięciu +PARTIAL_TAKE_PROFIT_R × stop
# sprzedaj PARTIAL_TAKE_PROFIT_FRAC pozycji (zaksięguj wygraną), resztę puść z
# trailingiem. PARTIAL_TAKE_PROFIT_ENABLED=false => wyłącz.
# REWARD_RISK_RATIO 1.5->2.0 i partial 0.5@1R -> 0.33@1.5R: symulacja ścieżkowa
# pokazała, że partial przycina zwycięzców, a szersze R:R lekko podnosi EV, gdy
# jest przewaga. Puszczamy zwycięzców dalej, bankujemy mniejszy kawałek później.
PARTIAL_TAKE_PROFIT_ENABLED=true
PARTIAL_TAKE_PROFIT_FRAC=0.33
PARTIAL_TAKE_PROFIT_R=1.5
# Anty-churn (Pakiet 2): próg pewności dla automatycznego BUY (poniżej =
# odrzucone, gotówka to też pozycja), limit NOWYCH wejść na dobę/portfel oraz
# minimalny czas trzymania przed wyjściem INNYM niż twardy stop (blokuje
# wskakiwanie i wyskakiwanie na spreadzie). 0 = wyłącz dany limit.
MIN_BUY_CONFIDENCE=0.57
MAX_NEW_POSITIONS_PER_DAY=5
MIN_HOLD_MINUTES=30
# Filtr konfluencji wejść (Tier 1 — przewaga wejścia to czynnik 1. rzędu):
# BUY musi przejść mechaniczny test trend+momentum+RSI. Score 0-3 z {SMA50>200,
# MACD byczy, RSI w zdrowej/momentum strefie}; wejście wymaga >= ENTRY_MIN_SCORE.
# 6-letni backtest pokazał, że wcześniejsze weto "RSI wykupiony" pogarszało wynik
# (mniej transakcji, niższa expectancy) — odrzucało kontynuacje silnych trendów
# (utrzymujące się wysokie RSI to normalka w trendzie, nie sygnał do unikania).
# Usunięte: RSI teraz tylko dokłada do wyniku. ENTRY_FILTER_ENABLED=false = wyłącz.
ENTRY_FILTER_ENABLED=true
ENTRY_MIN_SCORE=2
# Ilościowa auto-degradacja setupów (Tier 1): ticker z >= AUTO_DEMOTE_MIN_TRADES
# zamkniętymi transakcjami, ujemnym P&L i trafnością poniżej progu jest
# blokowany przed nowymi wejściami. AUTO_DEMOTE_ENABLED=false = wyłącz.
AUTO_DEMOTE_ENABLED=true
AUTO_DEMOTE_MIN_TRADES=5
AUTO_DEMOTE_WIN_RATE_FLOOR=40
# Ochrona przewagi (Tier 2): limit równoczesnych pozycji (skorelowana
# ekspozycja), oraz korekta rozmiaru dla nazw szerokospreadowych (płacą więcej
# na round-tripie, więc dostają mniejszy kawałek). 0 / 1.0 = wyłącz.
MAX_CONCURRENT_POSITIONS=6
HIGH_SPREAD_SYMBOLS=SH,PSQ,IWM,XLE,TLT
HIGH_SPREAD_SIZE_SCALE=0.6
# Sizing oparty na ryzyku + reżim rynku (Pakiet 3): rozmiar BUY tak dobrany, by
# trafienie stopa kosztowało max RISK_PER_TRADE_PCT całego konta (szerszy stop
# => mniejsza pozycja; działa jako GÓRNY limit, tylko zmniejsza). 0 = wyłącz.
# Bramka reżimu: w risk_off wolno KUPIĆ tylko nazwy defensywne/odwrotne
# (DEFENSIVE_SYMBOLS), reszta na HOLD. Reżim zawsze trafia do kontekstu Claude.
RISK_PER_TRADE_PCT=1.25
REGIME_GATE_ENABLED=true
REGIME_VIX_RISK_OFF=25
DEFENSIVE_SYMBOLS=GLD,TLT,SH,PSQ
# Krypto ma WŁASNY reżim ryzyka: SPY/VIX nie ma sensu dla rynku 24/7. Liczony
# z trendu BTC (proxy bety krypto) + szerokości rynku krypto. W risk_off
# krypto-longi na HOLD (gotówka to jedyna pozycja defensywna -- spot-only book
# nie ma odpowiednika ETF-u odwrotnego). false = sygnał do kontekstu Claude,
# bez twardej blokady.
CRYPTO_REGIME_GATE_ENABLED=true
CRYPTO_REGIME_BENCHMARK=BTCUSD
CRYPTO_DEFENSIVE_SYMBOLS=
# Auto-blacklist (Pakiet 4): jeśli ticker zaliczy AUTO_BLACKLIST_STOP_COUNT
# stop-lossów w AUTO_BLACKLIST_WINDOW_HOURS, blokada odkupu na
# AUTO_BLACKLIST_HOURS (kwarantanna). AUTO_BLACKLIST_STOP_COUNT=0 = wyłącz.
AUTO_BLACKLIST_STOP_COUNT=3
AUTO_BLACKLIST_WINDOW_HOURS=24
AUTO_BLACKLIST_HOURS=48
# Mail natychmiast po każdej transakcji (używa tej samej konfiguracji SMTP co
# raport dzienny; pomijany gdy SMTP nieustawiony). false = tylko raport dzienny.
TRADE_ALERTS_ENABLED=true
# Szeroki ETF rynkowy + płynne, dużej kapitalizacji akcje z dostępnymi
# zleceniami ułamkowymi/kwotowymi (notional) na Alpaca -- ważne przy małym
# koncie, bo cena akcji nie musi dzielić się równo na wielkość pozycji.
# Zlecenia bez prowizji, ale rynek działa tylko w godzinach sesji US.
# ZRÓŻNICOWANA lista (nie tylko tech beta): rdzeń SPY/QQQ/AAPL/NVDA, zmienny
# MSTR, aktywa nieskorelowane/defensywne GLD (złoto)/TLT (obligacje)/XLE
# (energia)/IWM (small-capy) oraz ETF-y ODWROTNE SH (inverse S&P)/PSQ (inverse
# Nasdaq) -- pozwalają zarabiać też na spadkach kupując je jak zwykłą pozycję,
# bez ryzyka klasycznego shorta.
# Rozszerzona, ZDYWERSYFIKOWANA lista: rdzeń (SPY/QQQ/DIA), pojedyncze akcje
# (AAPL/NVDA/MSTR/TSLA), surowce (GLD/SLV), obligacje (TLT), sektory
# (XLE/XLF/XLK/XLV/XLU/XLI/XLP), zagranica (EEM/EFA), small-capy (IWM) oraz
# ETF-y odwrotne (SH/PSQ). Sektory/zagranica pozwalają filtrowi trendu rotować
# do tego, co akurat rośnie, zamiast tkwić w tech. Wszystkie płynne + ułamkowe.
TRADING_WHITELIST=SPY,QQQ,DIA,AAPL,MSFT,NVDA,AMZN,GOOGL,META,AMD,AVGO,MSTR,TSLA,NFLX,COIN,GLD,SLV,TLT,XLE,XLF,XLK,XLV,XLU,XLI,XLP,EEM,EFA,IWM,SH,PSQ
# Benchmark: z czym porównywać całą strategię (bierne trzymanie tego tickera).
# Jeśli bot nie bije trzymania SPY, nie zarabia na swojej złożoności.
BENCHMARK_SYMBOL=SPY
# Sizing wg zmienności: rozmiar BUY jest skalowany W DÓŁ dla tickerów bardziej
# zmiennych niż ten próg (odchylenie std zwrotów 1h w %). 0 = wyłącz.
VOLATILITY_REFERENCE_PCT=1.5
# Dolny limit skalowania -- zmienny ticker nie zejdzie poniżej tej części tego,
# o co prosił Claude (żeby nie zsuwać pozycji do zera).
VOLATILITY_MIN_SCALE=0.35

# --- Harmonogram ---
# Timeframe świec dla sygnałów wejścia + skali stopa. "1d" = ŚWIECE DZIENNE
# (SMA50/200 dzienne = to, co backtest potwierdził). "1h" = szybciej, ale
# niezwalidowane i bardziej zaszumione.
SIGNAL_TIMEFRAME=1d
POLL_INTERVAL_MINUTES=15
# Próg ruchu ceny liczony NARASTAJĄCO od ostatniej analizy (kotwica), nie od
# poprzedniego sprawdzenia -- powolny trend też w końcu wyzwala analizę.
# Podniesione 2->3 (Tier 2): niższy próg budził Claude na szumie i generował
# transakcje o słabej przewadze. Szerszy próg = mniej, ale lepszych analiz.
PRICE_MOVE_TRIGGER_PCT=3
# Heartbeat: pełna analiza Claude co najmniej co tyle minut w godzinach
# handlu, nawet bez ruchu ceny -- bot regularnie patrzy na rynek zamiast
# czekać wyłącznie na skoki. 0 = wyłącz.
FULL_ANALYSIS_EVERY_MINUTES=120
# Akcje US handlują tylko w sesji regularnej (9:30-16:00 czasu New York,
# ~6.5h/dzień). Pre-market i after-hours zostały usunięte -- przy małym koncie
# kawałek pozycji jest mniejszy niż 1 akcja, a rozszerzone godziny wymagają
# całych akcji, więc i tak nic by nie kupiły/sprzedały. Handel nocny/24-7
# obsługuje osobny lot krypto (ten sam Alpaca, patrz CRYPTO_* wyżej).
# Blokada wejścia przed wynikami: mechaniczny stop-loss NIE chroni przed luką
# po earnings (cena przeskakuje stopa). Automat nie otworzy nowej pozycji na
# tickerze raportującym w ciągu tylu dni (SELL/HOLD nadal dozwolone). 0 =
# wyłącz. Działa tylko na ZNANE daty -- awaria kalendarza nie blokuje handlu.
EARNINGS_BLACKOUT_DAYS=2

# --- Budżet Claude (szacunek, nie realne saldo z console.anthropic.com - patrz README) ---
# Ustaw na kwotę, którą realnie doładowałeś na koncie Anthropic
CLAUDE_MONTHLY_BUDGET_USD=20
# Alert na dashboardzie gdy szacowane zużycie przekroczy ten % budżetu
CLAUDE_BUDGET_ALERT_THRESHOLD_PCT=80

# --- Codzienny raport mailowy (SMTP, np. Gmail + hasło aplikacji) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
REPORT_RECIPIENT_EMAIL=0grucha0@gmail.com
REPORT_HOUR=6
REPORT_MINUTE=0
REPORT_TIMEZONE=Europe/Warsaw

# --- Baza danych ---
DATABASE_URL=sqlite:///./data/trading.db

# --- Logowanie do dashboardu (opcjonalnie, jeśli puste - brak logowania!) ---
# Format: uzytkownik1:haslo1,uzytkownik2:haslo2
DASHBOARD_USERS=
