# Caddy reverse proxy for the GielDarek dashboard.
# Caddy terminuje HTTPS (automatyczny certyfikat Let's Encrypt) i przekazuje
# ruch do aplikacji na localhost:8000. Dzięki temu app NIE musi być wystawiona
# na świat po gołym HTTP -- patrz deploy/docker-compose.localhost.yml, które
# zmienia port na 127.0.0.1:8000, więc do bota da się dostać TYLKO przez Caddy.
#
# --- Wariant A: masz domenę (zalecane, prawdziwy cert Let's Encrypt) ---
# Podmień gie-d.example.com na swoją domenę wskazującą (rekord A) na IP serwera.
#
# gie-d.example.com {
#     encode zstd gzip
#     reverse_proxy 127.0.0.1:8000
# }
#
# --- Wariant B: sam adres IP (bez domeny) ---
# Let's Encrypt nie wystawia certów na IP, więc Caddy użyje własnego CA
# (self-signed). Przeglądarka pokaże ostrzeżenie -- to normalne, klikasz
# "zaawansowane -> kontynuuj". Ruch i tak jest szyfrowany.
:443 {
    tls internal
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
}

# Przekieruj gołe HTTP -> HTTPS.
:80 {
    redir https://{host}{uri} permanent
}
