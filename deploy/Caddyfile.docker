# Caddyfile for the DOCKERISED Caddy (deploy/docker-compose.caddy.yml).
# Same as deploy/Caddyfile but proxies to the app over the Docker network
# (service name "app") instead of 127.0.0.1 -- so no host install is needed.
#
# Trusted Let's Encrypt cert via sslip.io (public DNS name -> your IP). Green
# padlock, no warning, PWA-installable. Change the IP here if the server IP
# changes. For your own domain, replace the hostname with it (rekord A -> IP).
46.225.229.113.sslip.io {
    encode zstd gzip
    reverse_proxy app:8000
}

# --- Śpiewnik (osobna apka na tym samym serwerze) ---
# Subdomena sslip.io wskazuje na ten sam IP, więc Let's Encrypt wystawi zaufany
# cert automatycznie (zielona kłódka, PWA-installable), bez kupowania domeny.
# Proxy do kontenera `songbook` (nakładka songbook/deploy/docker-compose.songbook.yml).
# Uwaga: aktywne tylko, gdy usługa `songbook` działa w tym samym projekcie compose.
spiewnik.46.225.229.113.sslip.io {
    encode zstd gzip
    reverse_proxy songbook:8080
}
