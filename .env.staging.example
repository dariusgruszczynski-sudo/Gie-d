# ==========================================================================
# STAGING -- środowisko testowe obok produkcji (serwis app-staging, port 8001).
# ==========================================================================
# Najprościej: SKOPIUJ swój produkcyjny .env do .env.staging, a potem nadpisz
# TYLKO klucze poniżej. Reszta knobów (profile strategii, progi, whitelisty)
# ma zostać IDENTYCZNA jak na produkcji -- o to chodzi w "dokładnej kopii":
# testujesz ten sam kod z tymi samymi ustawieniami, tylko na wirtualnym koncie.
#
#   cp .env .env.staging
#   # następnie w .env.staging zmień to, co niżej:
#
# --------------------------------------------------------------------------
# 1. KONTO PAPER -- to jest cały sens stagingu. MUSZĄ to być klucze DRUGIEGO,
#    OSOBNEGO konta paper z app.alpaca.markets/paper/dashboard/overview.
#    NIE wklejaj tu kluczy produkcyjnych (żywego konta) -- dwa boty na jednym
#    koncie = podwójne zlecenia na realnych pieniądzach.
ALPACA_API_KEY=PK_TWOJE_KLUCZE_PAPER
ALPACA_API_SECRET=TWOJ_SEKRET_PAPER
# true = symulacja (paper). Na stagingu ZAWSZE true.
ALPACA_PAPER=true

# --------------------------------------------------------------------------
# 2. POWIADOMIENIA -- wyłącz na stagingu, żeby testy nie zasypywały Cię
#    push-ami i mailami "obok" produkcyjnych. (Puste = wyłączone.)
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMTP_HOST=
SHARE_TOKEN=

# --------------------------------------------------------------------------
# 3. (Opcjonalnie) Klucz Claude. Możesz użyć TEGO SAMEGO ANTHROPIC_API_KEY co
#    prod -- staging i tak domyślnie nie eskaluje do Opusa (lean-AI), więc koszt
#    jest znikomy. Jeśli chcesz zerowy koszt Claude na stagingu, zostaw pusty --
#    wtedy cykle będą działać mechaniką (stopy/take-profit), ale bez decyzji AI.
# ANTHROPIC_API_KEY=

# Wszystko poniżej (CRYPTO_*, profile, progi, whitelisty, limity ryzyka)
# SKOPIUJ 1:1 z produkcyjnego .env -- staging ma być ich wierną kopią.
